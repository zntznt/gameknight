{
  "name": "gameknight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Filter your board game collections down to the perfect game for the table.",
  "scripts": {
    "fetch": "node scripts/fetch-bgg.mjs",
    "serve": "python3 -m http.server 8080",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "html-validate \"**/*.html\"",
    "lint:fix": "eslint . --fix && stylelint \"css/**/*.css\" --fix"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "engines": {
    "node": ">=22.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "html-validate": "^11.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
